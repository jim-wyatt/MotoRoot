{
  "python.defaultInterpreterPath": "${workspaceFolder}/work/.venv/Scripts/python.exe",
  "terminal.integrated.profiles.windows": {
    "MotoRoot dev shell": {
      "source": "PowerShell",
      "args": ["-NoExit", "-ExecutionPolicy", "Bypass", "-Command", ". .\\dev\\Enter-DevShell.ps1"]
    }
  },
  "terminal.integrated.defaultProfile.windows": "MotoRoot dev shell",
  "files.exclude": {
    "**/__pycache__": true,
    "dev/.cache": true,
    "dev/.venv-docs": true,
    "site": true
  },
  "search.exclude": {
    "work": true,
    "dev/.tools": true,
    "dev/build": true
  },
  "git.ignoreLimitWarning": true
}
