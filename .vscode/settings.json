{
  "python.defaultInterpreterPath": "python",
  "terminal.integrated.profiles.windows": {
    "aosp-academy shell": {
      "path": "python",
      "args": ["-I", "aosp_academy/_launch.py", "shell"]
    }
  },
  "terminal.integrated.defaultProfile.windows": "aosp-academy shell",
  "files.exclude": {
    "**/__pycache__": true,
    "site": true
  },
  "search.exclude": {
    "work": true
  },
  "git.ignoreLimitWarning": true
}
