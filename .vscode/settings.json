{
  "python.defaultInterpreterPath": "${workspaceFolder}/work/.venv/Scripts/python.exe",
  "terminal.integrated.profiles.windows": {
    "VedoTom dev shell": {
      "source": "PowerShell",
      "args": ["-NoExit", "-ExecutionPolicy", "Bypass", "-Command", ". .\\workstation\\Enter-DevShell.ps1"]
    }
  },
  "terminal.integrated.defaultProfile.windows": "VedoTom dev shell",
  "files.exclude": {
    "**/__pycache__": true,
    "work/cache": true,
    "work/.venv-docs": true,
    "site": true
  },
  "search.exclude": {
    "work": true,
    "work/tools": true,
    "work/build": true
  },
  "git.ignoreLimitWarning": true
}
