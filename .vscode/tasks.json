{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Set up the workstation",
      "type": "shell",
      "command": "python -I aosp_academy/_launch.py setup",
      "problemMatcher": []
    },
    {
      "label": "Rebuild stock artifacts and compare",
      "type": "shell",
      "command": "python -I aosp_academy/_launch.py stock build",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Check the workstation",
      "type": "shell",
      "command": "python -I aosp_academy/_launch.py check",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Test the phone",
      "type": "shell",
      "command": "python -I aosp_academy/_launch.py device test",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Deploy the newest image",
      "type": "shell",
      "command": "python -I aosp_academy/_launch.py deploy",
      "problemMatcher": []
    },
    {
      "label": "Mirror the phone (scrcpy)",
      "type": "shell",
      "command": "python -I aosp_academy/_launch.py device mirror",
      "problemMatcher": []
    }
  ]
}
