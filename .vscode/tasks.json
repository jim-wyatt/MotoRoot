{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Bootstrap dev environment",
      "type": "shell",
      "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File .\\workstation\\Install-Workstation.ps1",
      "problemMatcher": []
    },
    {
      "label": "Rebuild device artifacts and compare",
      "type": "shell",
      "command": "pwsh -NoProfile -ExecutionPolicy Bypass -Command \". .\\workstation\\Enter-DevShell.ps1 | Out-Null; .\\stock\\Build-StockArtifacts.ps1\"",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Self-test dev environment",
      "type": "shell",
      "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File .\\workstation\\Test-Workstation.ps1",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Mirror phone (scrcpy)",
      "type": "shell",
      "command": "pwsh -NoProfile -ExecutionPolicy Bypass -Command \". .\\workstation\\Enter-DevShell.ps1 | Out-Null; $env:ADB = $adb; scrcpy\"",
      "problemMatcher": []
    }
  ]
}
