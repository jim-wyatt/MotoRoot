# VedoTom's contribution to the release configurations of this AOSP tree. The build finds it
# itself (build/make/core/release_config.mk reads device/*/*/release/release_config_map.textproto),
# and its values are applied after build/release's own.
#
# Why: the trunk_staging configuration this project builds selects an experimental MessageQueue
# (CombinedDeliMessageQueue) in which MessageQueue.next() is not marked @UnsupportedAppUsage, so
# Android blocks apps from calling it. Gecko, the engine of Fennec F-Droid (the image's browser),
# calls it from native code and crashes on start when it is blocked. The release configuration
# Android 16 ships for this source tag (bp4a) uses LegacyMessageQueue, where next() stays reachable;
# flag_values/ sets trunk_staging to the same. See docs/develop/aosp-build.md.
default_containers: "product"
default_containers: "system"
default_containers: "system_ext"
default_containers: "vendor"
