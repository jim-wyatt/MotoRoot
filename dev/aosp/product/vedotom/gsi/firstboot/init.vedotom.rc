# VedoTom first-boot service. Runs once per boot after sys.boot_completed, as root in the
# (userdebug-only, permissive) su domain, so it can call pm and write into app data folders.
# The script itself is idempotent; most boots it finds nothing to do and exits in a second.
service vedotom_firstboot /product/bin/vedotom-firstboot
    class late_start
    user root
    group root
    seclabel u:r:su:s0
    oneshot
    disabled

on property:sys.boot_completed=1
    start vedotom_firstboot

# 16 MiB log buffers (logd's default is 256 KiB, which the vendor's log spam rolls over in
# minutes). logd reads ro.logd.size / persist.logd.size at start only on automotive and desktop
# hardware types (system/logging/logd/LogSize.cpp), so a property alone does nothing on a phone;
# the size has to be set at runtime, as logcat -G does. logd sets logd.ready when it is up and
# clears it when it restarts, so this runs on every boot, early, and again after a logd restart.
service vedotom_logsize /system/bin/logcat -b main,system,crash,events,radio,kernel -G 16M
    user root
    group root log
    seclabel u:r:su:s0
    oneshot
    disabled

on property:logd.ready=true
    start vedotom_logsize
