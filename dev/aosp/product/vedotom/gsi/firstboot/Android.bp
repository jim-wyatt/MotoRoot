// The first-boot service of the VedoTom image: a shell script init starts once the system has
// booted, as root, to set what the image cannot from read-only partitions (the HOME role, the
// development settings, the hidden AOSP Files icon, the Fossify icon colour). It is idempotent
// and cheap on every later boot. init.vedotom.rc also sets the log buffer size on every boot.
// See vedotom-firstboot.sh and init.vedotom.rc.

package {
    default_applicable_licenses: ["device_vedotom_gsi_firstboot_license"],
}

license {
    name: "device_vedotom_gsi_firstboot_license",
    visibility: [":__subpackages__"],
    license_kinds: ["SPDX-license-identifier-MIT"],
}

sh_binary {
    name: "vedotom-firstboot",
    src: "vedotom-firstboot.sh",
    product_specific: true,
}

prebuilt_etc {
    name: "init.vedotom.rc",
    src: "init.vedotom.rc",
    sub_dir: "init",
    product_specific: true,
}
