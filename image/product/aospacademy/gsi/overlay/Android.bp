// aosp-academy's framework overlay: the defaults that make the image ours without touching upstream.
// A static runtime resource overlay on the product partition, applied to the framework
// (package "android") at boot. What it sets is in res/values/config.xml; the default wallpaper is
// res/drawable-nodpi/default_wallpaper.png, which Material You then derives the system colours from.

package {
    default_applicable_licenses: ["device_aospacademy_gsi_license"],
}

license {
    name: "device_aospacademy_gsi_license",
    visibility: [":__subpackages__"],
    license_kinds: ["SPDX-license-identifier-MIT"],
    license_text: ["LICENSE"],
}

runtime_resource_overlay {
    name: "AospAcademyFrameworkOverlay",
    product_specific: true,
}
