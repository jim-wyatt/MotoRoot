<?xml version="1.0" encoding="utf-8"?>
<!-- Connectivity-check endpoints for the aosp-academy image. Names and meanings are those of
     packages/modules/NetworkStack/res/values/config.xml (android-17.0.0_r1, unchanged since
     android-16.0.0_r4). GrapheneOS runs these
     for any client; they answer 204 like Google's connectivitycheck.gstatic.com. -->
<resources>
    <string name="config_captive_portal_http_url" translatable="false">http://connectivitycheck.grapheneos.network/generate_204</string>
    <string name="config_captive_portal_https_url" translatable="false">https://connectivitycheck.grapheneos.network/generate_204</string>
    <!-- The probe lists NetworkMonitor actually uses (makeCaptivePortalHttp[s]Urls, then
         getProbeUrlArrayConfig): a non-empty array here wins over the single URLs above and over
         Settings. Upstream leaves them empty, but the phone's vendor NetworkStackResOverlay
         (priority 7, below ours) fills them with gstatic and google.com, so build 6 still probed
         Google. Set both, so the vendor's lists are replaced. -->
    <string-array name="config_captive_portal_http_urls" translatable="false">
        <item>http://connectivitycheck.grapheneos.network/generate_204</item>
    </string-array>
    <string-array name="config_captive_portal_https_urls" translatable="false">
        <item>https://connectivitycheck.grapheneos.network/generate_204</item>
    </string-array>
    <!-- No literal commas: NetworkMonitor joins and splits this list on them. -->
    <string-array name="config_captive_portal_fallback_urls" translatable="false">
        <item>http://grapheneos.online/gen_204</item>
    </string-array>
</resources>
