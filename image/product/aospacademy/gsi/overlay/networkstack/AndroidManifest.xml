<?xml version="1.0" encoding="utf-8"?>
<!-- Static overlay on NetworkStack: enabled at boot, not toggleable from Settings. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="aospacademy.gsi.overlay.networkstack">
    <application android:hasCode="false" />
    <overlay
        android:targetPackage="com.android.networkstack"
        android:targetName="NetworkStackConfig"
        android:isStatic="true"
        android:priority="201" />
</manifest>
