+// physicalMemoryLimit returns 80% of this machine's RAM in bytes, or 0 when /proc/meminfo
+// can't be read (not Linux), in which case the Go runtime keeps its default of no limit.
+func physicalMemoryLimit() int64 {
+	data, err := os.ReadFile("/proc/meminfo")
+	if err != nil {
+		return 0
+	}
+	fields := strings.Fields(string(data))
+	for i, field := range fields {
+		if field != "MemTotal:" || i+1 >= len(fields) {
+			continue
+		}
+		kb, err := strconv.ParseInt(fields[i+1], 10, 64)
+		if err != nil {
+			return 0
+		}
+		return kb * 1024 / 10 * 8
+	}
+	return 0
+}
