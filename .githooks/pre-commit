#!/usr/bin/env bash
# Blocks commits that could publish device data from this phone project.
# Enabled by dev/Bootstrap-DevEnv.ps1 (git config core.hooksPath .githooks).
# If a block is a false positive and you have checked the file: git commit --no-verify

max_bytes=$((1024 * 1024))
fail=0
block() { echo "pre-commit: BLOCKED $1" >&2; fail=1; }

while IFS= read -r -d '' f; do
  case "$f" in
    work/*|*/private-backups/*|private-backups/*|backups/*|diagnostics/*|private/*|lk-analysis/*|lk-patch-analysis/*|magisk-patch-files/*|dev/.cache/*|dev/.tools/*|dev/build/*|dev/.venv-docs/*|site/*|\
    traces/*|*/traces/*|blobs/*|*/blobs/*|extracted/*|*/extracted/*|captures/*|*/captures/*|screenshots/*|*/screenshots/*|.venv*/*|*/.venv*/*)
      block "$f (private or generated folder)"; continue ;;
  esac
  case "${f,,}" in
    *.img|*.bin|*.apk|*.aab|*.msi|*.log|*.tar|*.csv|*.pem|*.key|*.pk8|*.p12|*.der|*.jks|*.keystore|*unlock-key*|.env|*/.env|.env.*|*/.env.*|*keystore.properties|*local.properties)
      block "$f (device image, installer, log, key material, or local secrets)"; continue ;;
    # adb's private key (adbkey, never adbkey.pub's twin) and trusted-key lists (adb_keys) are per machine.
    adbkey|*/adbkey|adb_keys|*/adb_keys|*wifi.json)
      block "$f (adb key material or Wi-Fi credentials)"; continue ;;
    # Traces, recordings and native libraries pulled from a device: app names, logs, vendor blobs.
    *.pftrace|*.perfetto-trace|*.mp4|*.mkv|*.so)
      block "$f (trace, screen recording or native library: may hold device data or vendor code)"; continue ;;
  esac
  size=$(git cat-file -s ":$f" 2>/dev/null || echo 0)
  if [ "$size" -gt "$max_bytes" ]; then
    block "$f ($size bytes; over 1 MiB - is this a dump or third-party binary?)"
  fi
done < <(git diff --cached --name-only -z --diff-filter=ACMR)

# Added lines that look like device identifiers: 15-digit IMEIs, or key: value identifier lines.
hits=$(git diff --cached -U0 --diff-filter=ACMR --no-color -- . ':(exclude)*.zip' ':(exclude)*.dex' ':(exclude)*.png' \
  | grep -E '^\+[^+]' \
  | grep -Ei '(^|[^0-9a-f])[0-9]{15}([^0-9a-f]|$)|(serialno|serial_number|imei|meid|ro\.serialno)[[:space:]]*[:=][[:space:]]*[A-Za-z0-9]{6,}')
if [ -n "$hits" ]; then
  block "staged lines look like device identifiers (IMEI/serial):"
  echo "$hits" | head -n 10 >&2
fi

if [ "$fail" -ne 0 ]; then
  echo "pre-commit: nothing was committed. Remove the item(s) from the index: git restore --staged <path>" >&2
  exit 1
fi
exit 0
